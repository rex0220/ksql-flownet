{
  "name": "@rex0220/ksql-flownet",
  "version": "0.1.0",
  "description": "Control Plane CLI for kSQL-Flow job networks",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/rex0220/ksql-flownet",
  "type": "module",
  "bin": {
    "ksql-flownet": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "node plugin/scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:plugin": "npm run build:plugin && kintone-plugin-packer --out plugin/zip/ksql-flownet-activity.zip plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && npm run build:plugin",
    "test": "node --test tests/unit/*.test.mjs",
    "test:plugin": "npm run build:plugin && node --test tests/unit/activity-plugin-*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@kintone/plugin-packer": "^9.1.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
