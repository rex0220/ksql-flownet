{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rex0220/ksql-flownet/schemas/network-definition.schema.json",
  "title": "kSQL-FlowNet network definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network_id",
    "business_key_policy",
    "network_lock",
    "nodes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "network_id": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string" },
    "business_key_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "period", "timezone", "format"],
          "properties": {
            "type": { "const": "scheduled_period" },
            "period": { "enum": ["day", "month"] },
            "timezone": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "explicit" }
          }
        }
      ]
    },
    "max_active_runs": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "network_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_duration_sec", "heartbeat_interval_sec"],
      "properties": {
        "lease_duration_sec": { "type": "integer", "minimum": 1 },
        "heartbeat_interval_sec": { "type": "integer", "minimum": 1 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "job_id",
          "sql",
          "depends_on",
          "trigger_rule",
          "idempotent"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "job_id": { "$ref": "#/$defs/identifier" },
          "sql": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" }
          },
          "trigger_rule": {
            "enum": ["all_success", "none_failed", "all_done"]
          },
          "idempotent": { "type": "boolean" },
          "inputs": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/sourceIdentifier" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "anyOf": [
          { "pattern": ":" },
          { "pattern": "\\u0000" },
          { "const": "__net__" }
        ]
      }
    },
    "sourceIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "anyOf": [
          { "pattern": "[:=]" },
          { "pattern": "[\\u0000-\\u001f\\u007f]" },
          { "const": "__net__" }
        ]
      }
    }
  }
}
