# 実機 E2E・スパイク用の環境変数(開発者向け。リリース配布物ではない)
# 使い方: 値を .env(リポジトリ直下・git 管理外)に置くか OS 環境変数に設定し、tests/e2e/setup-env.ps1 で読み込む。
# 書込可トークンは OS 環境変数にだけ置き、.env には閲覧のみトークンを置く(OS 環境変数が優先)。
# 変数の意味と安全境界: tests/e2e/README.md、spikes/*/README.md

# --- kintone 接続先(E2E・スパイク共通) ---
KSQL_SPIKE_BASE_URL=https://<subdomain>.cybozu.com

# --- FlowNet 永続化用スパイクアプリ(E2E の state / audit) ---
KSQL_SPIKE_APP_EXEC=
KSQL_SPIKE_APP_AUDIT=
KSQL_SPIKE_APP_INTEGRATED=               # 1 アプリ案(D-08 比較用・スパイク a のみ)
KSQL_SPIKE_TOKEN_EXEC_RO=                # 閲覧のみ(観察・結果照合)
KSQL_SPIKE_TOKEN_AUDIT_RO=
KSQL_SPIKE_TOKEN_INTEGRATED_RO=
KSQL_SPIKE_TOKEN_EXEC=                   # 書込可(閲覧・追加・編集・削除)は OS 環境変数へ
KSQL_SPIKE_TOKEN_AUDIT=
KSQL_SPIKE_TOKEN_INTEGRATED=

# --- kSQL-Flow JOBログ(E2E 専用アプリ) ---
KSQL_SPIKE_APP_LOGS=
KSQL_TOKEN_LOGS_RO=
KSQL_E2E_TOKEN_LOGS=
KSQL_E2E_TOKEN_LOGS_RO=

# --- E2E 専用の操作要求アプリ ---
KSQL_E2E_TOKEN_REQUESTS=
KSQL_E2E_TOKEN_REQUESTS_RO=

# --- CSV E2E 専用の取込先 fixture アプリ(templates/console/e2e/create-csv1-target-app.console.js) ---
KSQL_CSV1_TARGET_APP_ID=
KSQL_CSV1_TARGET_API_TOKEN=              # 閲覧・追加・編集・削除(cleanup に削除が必要)
