# kSQL-FlowNet 環境変数の雛形
#
# 使い方: このファイルを .env にコピーして値を入れる(.env は .gitignore 済み)。
#   - 実行サーバーでは root 所有 0600 の環境ファイルに export 形式で置き、cron 行で source する
#     (docs/installation.md §8.1)。node --env-file=.env でも読める
#   - OS の環境変数が同名の値より優先される
#   - トークン値をリポジトリ・Console・チャット・文書へ貼らない
# 変数の一覧と意味: docs/specification.md §2.2

# --- kintone 接続と kSQL-FlowNet のアプリ(必須) ---
KSQL_FLOWNET_BASE_URL="https://<subdomain>.cybozu.com"
KSQL_FLOWNET_PROFILE=prod                 # ksql.config.json のプロファイル名
KSQL_FLOWNET_STATE_APP_ID=                # 実行管理アプリ ID
KSQL_FLOWNET_STATE_API_TOKEN=             # 実行管理: レコード閲覧・追加・編集
KSQL_FLOWNET_AUDIT_APP_ID=                # 監査履歴アプリ ID
KSQL_FLOWNET_AUDIT_API_TOKEN=             # 監査履歴: レコード閲覧・追加・編集
KSQL_FLOW_LOG_APP_ID=                     # kSQL-Flow JOBログアプリ ID
KSQL_FLOW_LOG_API_TOKEN=                  # JOBログ: レコード閲覧(kSQL-Flow 側の書込トークンとは別)

# --- kSQL-Flow CLI の起動(必須) ---
# ジョブ資材リポジトリを cwd にして起動する前提。相対パスは cwd 基準
KSQL_FLOW_BIN=node
KSQL_FLOW_BIN_ARGS='["node_modules/@rex0220/ksql-flow/dist/cli.js"]'   # JSON 配列または空白区切り。グローバル導入なら KSQL_FLOW_BIN=ksql-flow で空
KSQL_FLOW_CONFIG=ksql.config.json
KSQL_FLOW_WORKDIR=/var/tmp/ksql-flownet   # Execution Result 等の作業ディレクトリ
KSQL_FLOW_GRACE_PERIOD_MS=30000           # 任意: 停止要求時に子プロセスへ与える猶予

# --- 操作要求ポーラー poll-requests(ボードからの操作を使う場合に必須) ---
KSQL_FLOWNET_REQUEST_APP_ID=              # 操作要求アプリ ID
KSQL_FLOWNET_REQUEST_API_TOKEN=           # 操作要求: レコード閲覧・編集(追加・削除は付けない)
KSQL_FLOWNET_REQUEST_ALLOWLIST_PATH=      # allowlist YAML の絶対パス(docs/specification.md §6.6)
KSQL_FLOWNET_REQUEST_HEARTBEAT_INTERVAL_MS=   # 任意: claim heartbeat 間隔の上書き
KSQL_FLOWNET_REQUEST_STALE_AFTER_MS=          # 任意: stale 判定の上書き

# --- CSV 入出力(nodes[].inputs / outputs を持つ network がある場合に必須) ---
KSQL_FLOWNET_IO_DIR=                      # IO ルートの絶対パス。入力は <IO_DIR>/in、出力は <IO_DIR>/out
KSQL_FLOWNET_IO_RETENTION_DAYS=90         # 入力ファイルの保持日数

# --- 識別(任意) ---
KSQL_FLOWNET_REQUESTED_BY="cron@<host>"     # Invocation の requested_by。ポーラーは要求ごとに上書きする
KSQL_FLOWNET_HOST=                        # ロック所有者のホスト識別(既定は OS のホスト名)
KSQL_FLOWNET_OWNER_INSTANCE_ID=           # 同一ホストで複数インスタンスを区別する場合だけ

# --- 復旧コマンド(resolve-node / record-job-unlock / force-unlock-network)を実行する操作者の環境 ---
# 操作者自身の認証主体を設定する(docs/runbook-recovery.md)。cron・ポーラーには不要
KSQL_FLOWNET_SERVICE_PRINCIPAL=
# force-unlock-network --stop-method cloud_run_job_execution を使う場合だけ(run.executions.get の最小権限)
KSQL_FLOWNET_GCP_ACCESS_TOKEN=
