# このファイルを .env という名前でコピーして使う（.env は .gitignore 済み）
# ここに書いた値より OS の環境変数が優先される（同名の変数を setx 等で設定済みならそちらが有効）
# トークン値・秘密情報をリポジトリ・Console・チャットへ貼らないこと

# --- kintone 接続先（M0スパイク検証環境 = my-ksql-jobs と同一） ---
KSQL_SPIKE_BASE_URL=https://devenxyfi.cybozu.com

# --- スパイク用アプリID（Consoleスクリプト完了時に表示されるIDを記入） ---
# 2アプリ案
KSQL_SPIKE_APP_EXEC=
KSQL_SPIKE_APP_AUDIT=
# 1アプリ案（D-08比較用）
KSQL_SPIKE_APP_INTEGRATED=

# --- AI（観察・結果照合）用: 閲覧のみトークン ---
# 各スパイクアプリで「レコード閲覧」のみのトークンを発行して貼る
KSQL_SPIKE_TOKEN_EXEC_RO=
KSQL_SPIKE_TOKEN_AUDIT_RO=
KSQL_SPIKE_TOKEN_INTEGRATED_RO=

# --- スパイク実行（人間が実行）用: 書込可トークン ---
# レコード閲覧・追加・編集・削除を許可したトークンを OS の環境変数に設定する
# （OS 環境変数が .env より優先されるため、この .env は閲覧のみのまま安全に共有できる）
KSQL_SPIKE_TOKEN_EXEC=
KSQL_SPIKE_TOKEN_AUDIT=
KSQL_SPIKE_TOKEN_INTEGRATED=

# --- 既存 実行ログアプリ（kSQL-Flow所有、Spike C/E の現行ログ実測用） ---
# my-ksql-jobs の .env と同名。閲覧のみトークンの値を共用してよい
KSQL_SPIKE_APP_LOGS=4249
KSQL_TOKEN_LOGS_RO=

# --- kSQL-FlowNet run-network (CLI options override these values) ---
KSQL_FLOWNET_PROFILE=
KSQL_FLOWNET_BASE_URL=
KSQL_FLOWNET_STATE_APP_ID=
KSQL_FLOWNET_AUDIT_APP_ID=
KSQL_FLOWNET_STATE_API_TOKEN=
KSQL_FLOWNET_AUDIT_API_TOKEN=
KSQL_FLOW_BIN=
KSQL_FLOW_CONFIG=
KSQL_FLOW_WORKDIR=
KSQL_FLOW_LOG_APP_ID=
KSQL_FLOW_LOG_API_TOKEN=
KSQL_FLOW_GRACE_PERIOD_MS=30000
